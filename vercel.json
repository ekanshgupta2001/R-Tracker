{
  "installCommand": "npm install",
  "buildCommand": "bash build.sh",
  "outputDirectory": ".",
  "functions": {
    "api/review.js": { "maxDuration": 30 },
    "api/join-team.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://apis.google.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com https://*.gstatic.com; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com wss://*.firebaseio.com https://*.gstatic.com https://*.firebaseapp.com; frame-src https://accounts.google.com https://*.firebaseapp.com;" }
      ]
    }
  ],
  "routes": [
    { "src": "/build\\.sh$", "status": 404, "dest": "/404.html" },
    { "src": "/\\.gitignore$", "status": 404, "dest": "/404.html" },
    { "src": "/config\\.example\\.js$", "status": 404, "dest": "/404.html" },
    { "src": "/vercel\\.json$", "status": 404, "dest": "/404.html" },
    { "src": "/README\\.md$", "status": 404, "dest": "/404.html" },
    { "src": "/firestore\\.rules$", "status": 404, "dest": "/404.html" },
    { "src": "/package\\.json$", "status": 404, "dest": "/404.html" },
    { "src": "/package-lock\\.json$", "status": 404, "dest": "/404.html" },
    { "src": "/api/(.*)\\.js$", "status": 404, "dest": "/404.html" },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
