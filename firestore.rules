// Firestore Security Rules for R-Tracker
// Deploy via: firebase deploy --only firestore:rules
// If on Spark plan, paste these rules manually in:
// Firebase Console → Firestore → Rules → Publish

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: can read own doc; create without teamId; update without changing role/teamId
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['teamId']);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'teamId']);
    }

    // User subcollections (curriculum, stats, levels, etc.) — validate score ranges
    match /users/{userId}/{subcollection=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['overallScore']) || (request.resource.data.overallScore >= 0 && request.resource.data.overallScore <= 100))
        && (!request.resource.data.keys().hasAny(['aiScore']) || (request.resource.data.aiScore >= 0 && request.resource.data.aiScore <= 100))
        && (!request.resource.data.keys().hasAny(['score']) || (request.resource.data.score >= 0 && request.resource.data.score <= 100))
        && (!request.resource.data.keys().hasAny(['levelsCompleted']) || (request.resource.data.levelsCompleted >= 0 && request.resource.data.levelsCompleted <= 20));
    }

    // Rate limit documents: strictly increment-only
    match /users/{userId}/rateLimit/{date} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.count == 1;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.count == resource.data.count + 1;
    }

    // Server-side rate limit documents (admin SDK only, no client access)
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Teams: anyone authed can read, only coaches can modify settings
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach';
    }

    // Team members: authed can read, own entry or coach can write
    match /teams/{teamId}/members/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == memberId ||
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach'
      );
    }

    // Team activity: restricted to team members only
    match /teams/{teamId}/activity/{activityId} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    // Strategies: team members can read/create, creators and coaches can modify
    match /teams/{teamId}/strategies/{strategyId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      allow update, delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach'
      );
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
