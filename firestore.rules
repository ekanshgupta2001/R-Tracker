// Firestore Security Rules for R-Tracker
// Deploy via: firebase deploy --only firestore:rules
// If on Spark plan, paste these rules manually in:
// Firebase Console → Firestore → Rules → Publish

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === USER DOCUMENTS ===
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['teamId', 'role']);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'teamId']);
    }

    // === USER SUBCOLLECTIONS (stats, curriculum, levels, coachReports, etc.) ===
    match /users/{userId}/{subcollection=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['overallScore']) || (request.resource.data.overallScore is number && request.resource.data.overallScore >= 0 && request.resource.data.overallScore <= 100))
        && (!request.resource.data.keys().hasAny(['overallRating']) || (request.resource.data.overallRating is number && request.resource.data.overallRating >= 0 && request.resource.data.overallRating <= 100))
        && (!request.resource.data.keys().hasAny(['aiScore']) || (request.resource.data.aiScore is number && request.resource.data.aiScore >= 0 && request.resource.data.aiScore <= 100))
        && (!request.resource.data.keys().hasAny(['score']) || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100))
        && (!request.resource.data.keys().hasAny(['bestStars']) || (request.resource.data.bestStars is number && request.resource.data.bestStars >= 0 && request.resource.data.bestStars <= 3))
        && (!request.resource.data.keys().hasAny(['levelsCompleted']) || (request.resource.data.levelsCompleted is number && request.resource.data.levelsCompleted >= 0 && request.resource.data.levelsCompleted <= 20));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // === RATE LIMIT (client-side — increment only, overrides subcollection wildcard) ===
    match /users/{userId}/rateLimit/{date} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.count is number
        && request.resource.data.count == 1;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.count is number
        && request.resource.data.count == resource.data.count + 1;
    }

    // === SERVER-SIDE RATE LIMITS (admin SDK only) ===
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // === TEAMS ===
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach';
    }

    // === TEAM MEMBERS ===
    match /teams/{teamId}/members/{memberId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      allow write: if request.auth != null && (
        request.auth.uid == memberId ||
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach'
      );
    }

    // === TEAM STRATEGIES ===
    match /teams/{teamId}/strategies/{strategyId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      allow update, delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach'
      );
    }

    // === TEAM ACTIVITY ===
    match /teams/{teamId}/activity/{activityId} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    // === DENY EVERYTHING ELSE ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
