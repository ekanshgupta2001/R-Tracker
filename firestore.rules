// Firestore Security Rules for R-Tracker
// Deploy via: firebase deploy --only firestore:rules
// If on Spark plan, paste these rules manually in:
// Firebase Console → Firestore → Rules → Publish

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read their own document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Users can create their own profile (first-time role selection)
      allow create: if request.auth != null && request.auth.uid == userId;
      // Users can update their own profile BUT cannot change the 'role' field
      // unless it's being set for the first time (role doesn't exist yet)
      allow update: if request.auth != null && request.auth.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            || !resource.data.keys().hasAny(['role']));
    }

    // User subcollections (curriculum, rateLimit, stats, etc.)
    match /users/{userId}/{subcollection=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['aiScore']) || request.resource.data.aiScore <= 100)
        && (!request.resource.data.keys().hasAny(['score']) || request.resource.data.score <= 100);
    }

    // Rate limit documents: can only increment, not reset to 0
    match /users/{userId}/rateLimit/{date} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.count >= resource.data.count;
    }

    // Server-side rate limit documents (written by admin SDK, no client access)
    match /rateLimits/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Team document: anyone authed can read, only coaches can write settings
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach';
    }

    // Team members
    match /teams/{teamId}/members/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == memberId ||
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach'
      );
    }

    // Team activity: authed members can create activity entries
    match /teams/{teamId}/activity/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Strategies: team members can read, creators and coaches can modify
    match /teams/{teamId}/strategies/{strategyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'coach'
      );
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
